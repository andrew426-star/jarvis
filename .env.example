# Groq — the brain. Model kept as an env var since Groq deprecates models on
# a cadence of months (e.g. llama-3.1-8b-instant / llama-3.3-70b-versatile
# were both fully shut down in 2026) — swapping this should be a redeploy,
# not a code change.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Whisper model for POST /transcribe (voice input). Same reasoning as
# GROQ_MODEL above for keeping this an env var, not hardcoded.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Supabase — same project K.I.V. (kiv-console) already uses
# (jibzwugivnktfesbrqcd), values copied straight from its .env.local. All of
# Jarvis's own tables are jarvis_-prefixed to stay unambiguous alongside
# kiv-console's own tables in the same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WebResearch tool — Tavily, same provider kiv-console uses
# (src/lib/ai/web-search.ts), but its own key to keep quota/billing
# separate between the two apps.
TAVILY_API_KEY=

# Redis (Upstash) — Tier 1 fast session context, REST API sync client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pinecone — Tier 3 semantic recall over past interactions. Integrated
# embedding index (Pinecone hosts llama-text-embed-v2 itself) — no separate
# embeddings-provider key needed. Run scripts/setup_pinecone_index.py once
# after setting this, before semantic recall has anything to search — safe
# to re-run, it's a no-op if the index already exists.
PINECONE_API_KEY=

# GoogleTitan (Gmail/Calendar/Drive/Docs) — same Google Cloud OAuth Client
# ID/Secret as kiv-console's registration (Andrew added GOOGLE_REDIRECT_URI
# below to that client's allowed redirect list); this is a fully separate
# consent grant/refresh token from kiv-console's own, stored in
# jarvis_google_connection. GOOGLE_OAUTH_STATE_SECRET is independent from
# the client secret — generate with: openssl rand -hex 32.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=

# MarketAnalysis tool — same Finnhub key kiv-console already uses
# (src/lib/market/finnhub.ts), reused rather than a fresh one, per Andrew.
FINNHUB_API_KEY=

# Portfolio tool — same Alpaca paper-trading keys kiv-console already uses
# (src/lib/portfolio/alpaca.ts). Paper and live are separate key pairs that
# only work against their matching base URL.
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets

# Company Financials tool — same LIVE Stripe key kiv-console already uses
# (src/lib/portfolio/stripe.ts). Read-only endpoints only (balance,
# balance_transactions) — nothing here can charge/refund/payout.
STRIPE_SECRET_KEY=

# GitHub tool — a fine-grained PAT scoped to whichever repo(s) it should
# open issues in (defaults below target Jarvis's own repo).
GITHUB_TOKEN=
GITHUB_REPO_OWNER=andrew426-star
GITHUB_REPO_NAME=jarvis

# News Feed tool — same NewsAPI key kiv-console already uses
# (src/lib/news/newsapi.ts). Cached in Redis for 4h since this is the same
# 100-req/24h quota kiv-console's own polling already runs close to.
NEWSAPI_KEY=

# Spotify tool — a separate Developer app/OAuth flow, nothing reused from
# Google. Optional: the app boots fine without these, the tool just
# reports "not configured" until they're set. SPOTIFY_OAUTH_STATE_SECRET
# is its own secret, not shared with GOOGLE_OAUTH_STATE_SECRET — generate
# with: openssl rand -hex 32.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_OAUTH_STATE_SECRET=

# Zoho Mail tool — read-only access to Andrew's Zoho Mail business inbox
# (andrew.thomas@kivaroai.com), a completely separate service/OAuth app
# from Google/Gmail. Optional: the app boots fine without these, the tool
# just reports "not configured" until they're set — same reasoning as
# Spotify above. ZOHO_OAUTH_STATE_SECRET is its own secret, not shared
# with GOOGLE_OAUTH_STATE_SECRET/SPOTIFY_OAUTH_STATE_SECRET — generate
# with: openssl rand -hex 32. Must be registered in Zoho's API Console as
# a "Server-based Application" (NOT "Self Client" — Self Client has no
# redirect URI and can't drive this connect/callback flow). Domains
# default to the US data center (accounts.zoho.com / mail.zoho.com),
# correct for a Dallas, TX company — override only if the API Console
# shows a different data center.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_OAUTH_STATE_SECRET=
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=mail.zoho.com

# POST /speak (text-to-speech), separate from /invoke. Optional: the app
# boots fine without these, /speak just returns a clear "not configured"
# error until they're set. FISH_AUDIO_VOICE_ID is Fish's reference_id and
# has no hardcoded fallback — it names a specific voice, which isn't
# guessable. FISH_AUDIO_MODEL defaults to s2.1-pro, kept as an env var
# since these get superseded on their own cadence (same as GROQ_MODEL).
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

# Shared-secret gate for /invoke and /speak (the jarvis-frontend login
# screen asks for this once, stores it, sends it as Authorization: Bearer
# on every call). Optional in config so a missing value can't break boot,
# but unlike every other Optional above, an unset value here means every
# request is REJECTED (fails closed), not degraded gracefully — this is a
# security gate being deliberately added, not a pre-existing integration.
# A real passphrase you choose and type once, not a generated secret.
JARVIS_ACCESS_TOKEN=

# CORS allowlist — the deployed jarvis-frontend's exact origin (scheme +
# host, no trailing slash), e.g. https://jarvis-frontend-production.up.railway.app.
# http://localhost:3000 is already allowed unconditionally for local
# frontend dev against this deployed backend.
JARVIS_FRONTEND_ORIGIN=

# --- Console sign-in (Google, allowlisted) ---------------------------
# A SECOND redirect URI on the same OAuth client as GOOGLE_REDIRECT_URI,
# registered separately in the Google Cloud console. Sign-in asks only for
# `openid email`; the connect flow above asks for Gmail/Drive/Docs.
GOOGLE_LOGIN_REDIRECT_URI=
# Comma-separated. Fails CLOSED — unset means nobody can sign in.
JARVIS_ALLOWED_EMAILS=
# openssl rand -hex 32. Rotating it invalidates every session at once.
JARVIS_SESSION_SECRET=
# Where sign-in returns the browser. Leave EMPTY in production (it then
# returns to the host the request arrived on). Set to http://localhost:3000
# only for `next dev`. Not the same thing as JARVIS_FRONTEND_ORIGIN, which
# is CORS-only — conflating them once redirected sign-in to a dead host.
JARVIS_LOGIN_RETURN_ORIGIN=
