# Base URL of the Jarvis API, inlined into the client bundle at BUILD
# time (not read at runtime).
#
# LEAVE THIS EMPTY for any real build. In production the FastAPI app
# serves this bundle itself, so the API is same-origin and a bare
# "/invoke" is already correct. Setting it would hardcode a cross-origin
# host into the bundle for no reason.
#
# The one case that needs a value is running `next dev` on :3000 against
# a local backend on :8000 — put that in .env.development.local (which
# `next dev` prefers over this file, and which `next build` ignores):
#
#   NEXT_PUBLIC_JARVIS_API_URL=http://localhost:8000
NEXT_PUBLIC_JARVIS_API_URL=
